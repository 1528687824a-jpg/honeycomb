DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal
DBOS_SYSTEM_DATABASE_URL=
DBOS_SYSTEM_DATABASE_SCHEMA=dbos
DBOS_ADMIN_SERVER=false
DBOS_ADMIN_PORT=3001
DBOS_LOG_LEVEL=info
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
HONEYCOMB_API_TOKEN=
# Local development only. Leave false/empty for packaged desktop and releases.
HONEYCOMB_ALLOW_INSECURE_API=false

# Feishu/Lark bot integration. Feishu is only a display screen: the messages
# may start with @agent-name for humans, but DBOS/Postgres control the flow.
FEISHU_DEFAULT_CHAT_ID=
FEISHU_DRY_RUN=true

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Optional: ignore webhook events sent by the same bot if Feishu echoes them.
FEISHU_BOT_OPEN_ID=

# OpenClaw agent runtime. Default is mock so local DBOS/Postgres checks run
# without spending model calls. Set OPENCLAW_AGENT_MODE=real after verifying
# WSL OpenClaw/gateway and provider keys.
OPENCLAW_AGENT_MODE=mock
OPENCLAW_WSL_DISTRO=Ubuntu-24.04
OPENCLAW_CLI=/home/administrator/.npm-global/bin/openclaw
OPENCLAW_AGENT_TIMEOUT_SECONDS=600
# Prevent concurrent workers from dispatching the same provider request.
MODEL_CALL_LEASE_SECONDS=900
# Automatic recovery maintenance runs in both API and worker processes, but a
# PostgreSQL advisory lock allows only one process to scan each interval.
HONEYCOMB_RUNTIME_MAINTENANCE_ENABLED=true
HONEYCOMB_RUNTIME_MAINTENANCE_INTERVAL_SECONDS=30
HONEYCOMB_RUNTIME_MAINTENANCE_HEARTBEAT_LIMIT=100
HONEYCOMB_RUNTIME_MAINTENANCE_MODEL_CALL_LIMIT=100
# A running/last-completed maintenance cycle is stale after this many seconds.
# Blank uses max(3 * interval, 120).
HONEYCOMB_RUNTIME_MAINTENANCE_STALE_SECONDS=
JOB_HEARTBEAT_TIMEOUT_SECONDS=300
# Provider-direct video is asynchronous. Honeycomb polls the persisted task ID,
# retries status reads without creating another task, and downloads the MP4.
OPENCLAW_VIDEO_POLL_INTERVAL_MS=10000
# One DBOS attempt polls for this long; blank uses OPENCLAW_AGENT_TIMEOUT_SECONDS.
OPENCLAW_VIDEO_POLL_WINDOW_MS=
OPENCLAW_VIDEO_STATUS_REQUEST_TIMEOUT_MS=30000
OPENCLAW_MEDIA_DOWNLOAD_TIMEOUT_MS=60000
OPENCLAW_MEDIA_DOWNLOAD_MAX_BYTES=262144000
# Deterministic still-image normalization before delivery. The source image is
# preserved; derived files are bounded and large aspect-ratio crops fail closed.
HONEYCOMB_IMAGE_NORMALIZE_MAX_INPUT_BYTES=52428800
HONEYCOMB_IMAGE_NORMALIZE_MAX_OUTPUT_BYTES=104857600
HONEYCOMB_IMAGE_NORMALIZE_MAX_INPUT_PIXELS=100000000
HONEYCOMB_IMAGE_NORMALIZE_MAX_OUTPUT_PIXELS=100000000
HONEYCOMB_IMAGE_NORMALIZE_MAX_DIMENSION=32768
HONEYCOMB_IMAGE_NORMALIZE_MAX_CROP_FRACTION=0.15
HONEYCOMB_IMAGE_NORMALIZE_TIMEOUT_SECONDS=60
# Real document files and derived PDF/DOCX outputs.
HONEYCOMB_DOCUMENT_MAX_INPUT_BYTES=52428800
HONEYCOMB_DOCUMENT_MAX_OUTPUT_BYTES=104857600
HONEYCOMB_DOCUMENT_MAX_TEXT_CHARACTERS=2000000
HONEYCOMB_DOCUMENT_MAX_ZIP_ENTRIES=5000
HONEYCOMB_DOCUMENT_MAX_ZIP_UNCOMPRESSED_BYTES=209715200
HONEYCOMB_DOCUMENT_MAX_ZIP_ENTRY_BYTES=20971520
HONEYCOMB_DOCUMENT_MAX_DISCOVERED_FILES=200
HONEYCOMB_DOCUMENT_MAX_DISCOVERY_DEPTH=3
# Optional outside Docker. For a TTC collection, FACE must be the internal
# PostScript name (for example MicrosoftYaHei), not the visible family label.
HONEYCOMB_DOCUMENT_PDF_FONT_PATH=
HONEYCOMB_DOCUMENT_PDF_FONT_FACE=

# Persistent model-call queue limits. These apply only to real child-agent
# calls and are enforced across worker processes through PostgreSQL leases.
HONEYCOMB_MODEL_CONCURRENCY_GLOBAL=4
HONEYCOMB_MODEL_CONCURRENCY_PER_PROVIDER=2
HONEYCOMB_MODEL_CONCURRENCY_PER_AGENT=1
HONEYCOMB_MODEL_QUEUE_POLL_MS=750
HONEYCOMB_MODEL_QUEUE_WAIT_TIMEOUT_SECONDS=600
HONEYCOMB_MODEL_QUEUE_HEARTBEAT_TTL_SECONDS=30
HONEYCOMB_MODEL_QUEUE_LEASE_GRACE_SECONDS=45
HONEYCOMB_JOB_CANCELLATION_POLL_MS=750

# Safe provider retry policy. Only explicit transient failures are retried;
# requests with an unknown outcome pause for human review instead.
HONEYCOMB_MODEL_RETRY_MAX_ATTEMPTS=3
HONEYCOMB_MODEL_RETRY_BASE_DELAY_MS=1000
HONEYCOMB_MODEL_RETRY_MAX_DELAY_MS=60000
HONEYCOMB_MODEL_RETRY_JITTER_RATIO=0.2

# Optional hard spend controls in USD. They are disabled while blank. When any
# limit is enabled, every real provider request must have provider pricing plus
# a safe per-request/token bound; otherwise the task pauses before dispatch.
HONEYCOMB_DEFAULT_JOB_MAX_COST_USD=
HONEYCOMB_USER_DAILY_MAX_COST_USD=
HONEYCOMB_PROVIDER_DAILY_MAX_COST_USD=
# Provider-direct chat already has an exact output cap. Native/WSL OpenClaw
# routes need explicit token ceilings here or provider metadata maxPerRequestUsd.
OPENCLAW_PROVIDER_DIRECT_MAX_TOKENS=1200
HONEYCOMB_SPEND_RESERVATION_MAX_INPUT_TOKENS=
HONEYCOMB_SPEND_RESERVATION_MAX_OUTPUT_TOKENS=

# Optional M3 real planner. Default generator mode is mock. To call a real
# OpenAI-compatible chat-completions provider, set these without committing
# secrets.
M3_PLANNER_MODE=mock
M3_PLANNER_BASE_URL=
M3_PLANNER_MODEL=
M3_PLANNER_API_KEY=
M3_PLANNER_TEMPERATURE=0.2
M3_PLANNER_TIMEOUT_SECONDS=60

# Job/session lifecycle. Completed sessions are archived immediately but only
# become eligible for heavy intermediate cleanup after this many days.
SESSION_RETENTION_DAYS=30
